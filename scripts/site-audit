#!/bin/bash
# Weekly security and update check of a web server. Runs as root, read-only.
# Called from the monitoring host through the "rescue" access: ssh -i rescue_key rescue@<server> audit
# (site-rescue forwards "audit" here). Changes nothing, only stores the WordPress
# checksums in a temp directory that is deleted at the end.
# Output per line: H|key|value  C|path|cms|version  P|path|plugin|version  T|path|theme|version  X|path|type|detail
export LC_ALL=C
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TMPD=$(mktemp -d); trap 'rm -rf "$TMPD"' EXIT
renice -n 19 $$ >/dev/null 2>&1; ionice -c3 -p $$ >/dev/null 2>&1
H() { printf 'H|%s|%s\n' "$1" "$2"; }

H host "$(hostname -f 2>/dev/null || hostname)"
H os "$(. /etc/os-release 2>/dev/null; echo "$PRETTY_NAME")"
H kernel "$(uname -r)"
H uptime "$(uptime | sed 's/^ *//')"
H php_cli "$(php -v 2>/dev/null | head -1)"
H php_installed "$(ls -d /etc/php/*/ /etc/php5 2>/dev/null | tr '\n' ' ')"
H php_fpm "$(ps -eo args | grep -oE 'php-fpm(: master process )?\(?/etc/php/[0-9.]+' | sort -u | tr '\n' ' ')"
H apache "$(apache2 -v 2>/dev/null | head -1; /usr/sbin/apache2 -v 2>/dev/null | head -1)"
H nginx "$(nginx -v 2>&1 | head -1)"
H openssl "$(openssl version 2>/dev/null)"
H mysql_local "$(mysqld --version 2>/dev/null || mysql --version 2>/dev/null)"
H apt_lists_age_days "$(( ( $(date +%s) - $(stat -c %Y /var/lib/apt/lists 2>/dev/null || echo 0) ) / 86400 ))"
up=$(apt list --upgradable 2>/dev/null | grep -c upgradable)
sec=$(apt list --upgradable 2>/dev/null | grep -c -- '-security')
H apt_upgradable "$up"
H apt_upgradable_security "$sec"
H apt_upgradable_sample "$(apt list --upgradable 2>/dev/null | grep upgradable | cut -d/ -f1 | head -25 | tr '\n' ' ')"
H reboot_required "$( [ -f /var/run/reboot-required ] && cat /var/run/reboot-required.pkgs 2>/dev/null | tr '\n' ' ' || echo no)"
H unattended "$(ls /etc/apt/apt.conf.d/ 2>/dev/null | grep -i unattended | tr '\n' ' ')"
H mailq "$( (postqueue -p 2>/dev/null || mailq 2>/dev/null) | tail -1)"
H listen "$(ss -ltn 2>/dev/null | awk 'NR>1{print $4}' | sed 's/.*://' | sort -un | tr '\n' ' ')"
H homes "$(ls -d /home/*/ 2>/dev/null | grep -cvE '\.[0-9]{9,}/$')"
H homes_archived "$(ls -d /home/*/ 2>/dev/null | grep -cE '\.[0-9]{9,}/$')"
H disk "$(df -hP /home 2>/dev/null | tail -1 | awk '{print $5" used of "$2}')"

# Suspicious processes (any user) and executables in temp dirs
ps -eo user:20,pid,etime,pcpu,args --sort=-pcpu 2>/dev/null | awk 'NR>1' |
  grep -E 'xmrig|minerd|kdevtmpfsi|kinsing|cryptonight|stratum|/tmp/|/var/tmp/|/dev/shm/|perl .*\.(pl|cgi)|perl -e|python[23]? -c|\bnc -|ncat|socat|/\.[a-z]|gsocket|gs-netcat|tsunami|xmr' |
  grep -vE 'grep|audit' | head -20 | while read -r l; do printf 'X|server|proc|%s\n' "$l"; done
ps -eo user:20,pcpu,etime,args --sort=-pcpu 2>/dev/null | awk 'NR>1 && NR<=9' | while read -r l; do printf 'H|topcpu|%s\n' "$l"; done
find /tmp /var/tmp /dev/shm -maxdepth 3 -type f \( -perm -u+x -o -name '*.php' -o -name '*.pl' -o -name '*.sh' -o -name '*.py' \) 2>/dev/null | head -30 |
  while read -r f; do printf 'X|server|tmpexec|%s %s\n' "$(stat -c '%U %y' "$f" 2>/dev/null | cut -c1-30)" "$f"; done

# Domains per DocumentRoot from the vhosts (root can read sites-enabled): V|docroot|domain domain ...
for f in /etc/apache2/sites-enabled/*; do
  awk 'tolower($1) ~ /^server(name|alias)$/ { for (i = 2; i <= NF; i++) d = d " " $i }
       tolower($1) == "documentroot" { gsub(/"/, "", $2); r = $2 }
       tolower($1) == "use" { dd = ""; rr = ""; for (i = 3; i <= NF; i++) { a = $i; gsub(/\"/, "", a)
           if (a ~ /^\//) rr = a; else if (a ~ /\./) dd = dd " " a }
         if (rr != "" && dd != "") print "V|" rr "|" dd }
       tolower($1) == "</virtualhost>" { if (r != "" && d != "") print "V|" r "|" d; d = ""; r = "" }' "$f" 2>/dev/null
done | sed 's#/|#|#' | sort -u

# Find CMS installations below /home (skip archived homes)
SIG='eval[[:space:]]*\([[:space:]]*(base64_decode|gzinflate|gzuncompress|str_rot13|strrev|rawurldecode|hex2bin)[[:space:]]*\(|eval[[:space:]]*\([[:space:]]*\$_(POST|GET|REQUEST|COOKIE|SERVER)|assert[[:space:]]*\([[:space:]]*\$_(POST|GET|REQUEST|COOKIE)|\$_(POST|GET|REQUEST|COOKIE)\[[^]]{1,40}\][[:space:]]*\(|FilesMan|WSOsetcookie|b374k|r57shell|c99shell|IndoXploit|Mister Spy|ALFA_DATA|AlfaTeam|anonymousfox|TinyFileManager|@include[[:space:]]*["'"'"'](\\x[0-9a-fA-F]{2}){4}|\\x65\\x76\\x61\\x6c|\$GLOBALS\[["'"'"'][a-zA-Z0-9_]+["'"'"']\]\[[0-9]+\]\(|preg_replace[[:space:]]*\([[:space:]]*["'"'"'].{1,40}/e["'"'"']'

# Content check (perl, read-only): obfuscation, webshell patterns, PHP in images/media dirs, injected first line
cat > "$TMPD/scan.pl" <<'PERL'
use strict; use warnings; use File::Find;
my ($root, $okfile) = @ARGV; my %hit; my %ok;
if ($okfile && open(my $oh, '<', $okfile)) { while (<$oh>) { chomp; $ok{$_} = 1; } close $oh; }
my $conf = ''; for my $cf (glob("$root/typo3conf/*.php"), glob("$root/wp-config.php")) { open(my $ch, '<', $cf) or next; local $/; $conf .= <$ch> // ''; close $ch; }
my $danger = qr/\b(eval|assert|base64_decode|gzinflate|gzuncompress|str_rot13|parse_str|create_function|call_user_func(?:_array)?|preg_replace|file_put_contents|move_uploaded_file|shell_exec|passthru|system|proc_open|popen|fsockopen|curl_exec|hex2bin|strrev|rawurldecode)\s*(?:\/\*.*?\*\/\s*)?\(/is;
my $sig = qr/eval\s*\(\s*(base64_decode|gzinflate|gzuncompress|str_rot13|rawurldecode|hex2bin)\s*\(|eval\s*\(\s*\$_(POST|GET|REQUEST|COOKIE|SERVER)|assert\s*\(\s*\$_(POST|GET|REQUEST|COOKIE)|\$_(POST|GET|REQUEST|COOKIE)\[[^\]]{1,40}\]\s*\(\s*\$_|FilesMan|WSOsetcookie|b374k|r57shell|c99shell|IndoXploit|Mister Spy|ALFA_DATA|AlfaTeam|anonymousfox|\\x65\\x76\\x61\\x6c|\$GLOBALS\[["'][a-zA-Z0-9_]+["']\]\[[0-9]+\]\(/;
my $legit = qr{/(vendor|vendor_prefixed|typo3_src|node_modules|wflogs|realurl|adodb|rokcommon|Doctrine|tcpdf|Zend|simplepie|getid3|phpseclib|phpmailer|Mail_Mime|all-in-one-wp-security-and-firewall/classes/firewall|wordfence/|sucuri-scanner|better-wp-security|ninjafirewall|Customweb)/}i;
sub obf {  # obfuscated: dangerous function in mixed case or many /*...*/ comment chains
  my ($c) = @_;
  while ($c =~ /$danger/g) { my $f = $1; return "function $f in mixed case" if substr($f, 1) ne lc substr($f, 1) && $f ne uc $f; }
  my $n = () = $c =~ /\*\/\s*\.\s*(?:\/\/|\/\*|['"])/g; return "obfuscated strings ($n comment chains)" if $n >= 8;
  return "malware pattern: $1" if $c =~ /($sig)/;
  return "encoded block is executed" if length($c) < 150_000 && $c !~ /BEGIN CERTIFICATE|data:image|data:font|data:application/
    && $c =~ /[A-Za-z0-9+\/=]{2000,}/ && $c =~ /\b(eval|assert|create_function)\s*\(|\$\w+\s*\(\s*\$\w+\s*\(/;
  return '';
}
find({ no_chdir => 1, wanted => sub {
  my $f = $File::Find::name;
  if (-d $f) { $File::Find::prune = 1 if $f =~ m{/(node_modules|\.git|typo3temp/var/(?:C|c)ache|typo3temp/Cache|wp-content/cache)$}; return; }
  return unless -f $f;
  my $r = substr($f, length($root) + 1);
  if ($r =~ /\.(php\d?|phtml|phar|inc|suspected)$/i) {
    # Location alone is enough: PHP in upload/media/lang directories
    if ($r =~ m{^(fileadmin|uploads|typo3conf/l10n|typo3temp)/}i && $r !~ m{^typo3temp/(var|Cache|autoload|ExtensionManager|Core|compressor)/}i) {
      my ($b) = $r =~ m{([^/]+)$};
      if ($r =~ m{^fileadmin/}i) {   # fileadmin: only with dangerous functions and not included from the configuration
        if (index($conf, $b) < 0 && -s $f < 3_000_000 && open(my $fh, '<', $f)) { local $/; my $c = <$fh> // ''; close $fh;
          my $o = obf($c); $hit{$r} = "fileadmin: $o" if $o; }
      } else { $hit{$r} = 'PHP in media/temp directory'; } }
    elsif ($r =~ m{^(wp-content|web/app)/uploads/}i && $r !~ m{/uploads/(cache|mailpoet|smush|smile_fonts|redux|borlabs-cookie|revslider|visualcomposer-assets|matomo|mailchimp-for-wp|et-cache|wpml|wc-logs|wpforms|gravity_forms|elementor|wp-staging|woocommerce_uploads|wpo|ai1wm-backups|backwpup|updraft|avia_fonts|woocommerce-pdf-invoices|wpo_wcpdf|dynamic_avia)/}i
           && -s $f < 3_000_000 && open(my $uh, '<', $f)) { local $/; my $c = <$uh> // ''; close $uh;
      $hit{$r} = 'PHP with dangerous functions in upload directory' if $c =~ $danger || $c =~ /base64|\\x[0-9a-f]{2}/i; }
    $hit{$r} ||= 'spam page (name)' if $r =~ m{(^|/)[^/]*(viagra|cialis|kamagra|levitra|tadalafil|sildenafil|apcalis|potenzmittel|priligy|dapoxetin|casino-bonus)[^/]*\.php$}i;
    return if -s $f > 3_000_000;
    open(my $h, '<', $f) or return; local $/; my $c = <$h> // ''; close $h;
    return if $r =~ m{(^|/)application/logs/log-[\d-]+\.php$};
    return if $f =~ $legit || $ok{$r} || $r =~ /\.l10n\.php$/ || $r =~ m{/languages/};
    # Injected first line before an otherwise genuine file: remove only that line
    my $ev = qr/(?:\@?(?:eval|assert)\s*\(\s*\$_(?:POST|GET|REQUEST|COOKIE)\[[^\]]{1,60}\]\s*\)\s*;\s*)+
/;
    if ($c =~ /\A<\?php\s+$ev(?:\?>\s*)?\n/ && obf($c =~ s/\A<\?php\s+$ev(?:\?>\s*)?\n/<?php\n/r) eq '') { $hit{$r} = 'INJECT'; return; }
    my $o = obf($c); $hit{$r} ||= $o if $o;
  } elsif ($r =~ /\.(ico|png|jpe?g|gif|orf|tmp)$/i && -s $f < 400_000) {
    open(my $h, '<', $f) or return; local $/; my $c = <$h> // ''; close $h;
    $hit{$r} = 'PHP code in non-PHP file' if $c =~ /<\?php/ && ($c =~ $danger) && $r !~ m{^typo3temp/var/};
  }
}}, $root);
# Directories whose PHP files are all suspicious (at least 20): report them as a whole
my (%n, %tot);
for (keys %hit) { my ($d) = m{^(.*)/[^/]+$}; $n{$d}++ if defined $d; }
for my $d (keys %n) { next if $n{$d} < 20; opendir(my $dh, "$root/$d") or next; my @a = grep { -f "$root/$d/$_" } readdir $dh; closedir $dh;
  if (@a <= $n{$d} + 2 || $n{$d} >= 0.9 * @a) { delete $hit{$_} for grep { m{^\Q$d\E/[^/]+$} } keys %hit; $hit{$d} = "directory with $n{$d} spam/malicious files"; } }
print "$hit{$_}\t$_\n" for sort keys %hit;
PERL

scan_root() { # docroot
  local r="$1"
  # signature grep (skip caches and node_modules)
  find "$r" -xdev \( -path '*/node_modules' -o -path '*/cache' -o -path '*/wp-content/cache' -o -path '*/typo3temp' -o -path '*/.git' \) -prune -o \
       -type f \( -name '*.php' -o -name '*.phtml' -o -name '*.php5' -o -name '*.php7' -o -name '*.inc' -o -name '*.ico' \) -size -3M -print0 2>/dev/null |
    xargs -0 -r grep -lIE -- "$SIG" 2>/dev/null | head -15 | while read -r f; do
      printf 'X|%s|sig|%s %s :: %s\n' "$r" "$(stat -c '%y' "$f" | cut -c1-16)" "${f#$r/}" "$(grep -oE -m1 -- "$SIG" "$f" 2>/dev/null | head -1 | cut -c1-60)"; done
  # perl check (also finds obfuscated shells the grep pattern does not know)
  perl "$TMPD/scan.pl" "$r" "" 2>/dev/null | head -25 | while IFS=$'\t' read -r why f; do
    [ "$why" = INJECT ] && why="injected first line (backdoor)"
    printf 'X|%s|sig|%s %s :: %s\n' "$r" "$(stat -c '%y' "$r/$f" 2>/dev/null | cut -c1-16)" "$f" "$why"; done
  # php inside image/ico files
  find "$r" -xdev -type f \( -name '*.ico' -o -name '*.png' -o -name '*.jpg' -o -name '*.gif' \) -size -300k -print0 2>/dev/null |
    xargs -0 -r grep -l '<?php' 2>/dev/null | head -5 | while read -r f; do printf 'X|%s|php_in_image|%s\n' "$r" "${f#$r/}"; done
  find "$r" -xdev -name '.*.ico' 2>/dev/null | head -5 | while read -r f; do printf 'X|%s|hidden_ico|%s\n' "$r" "${f#$r/}"; done
  # PHP in upload dirs
  find "$r" -xdev \( -path '*/wp-content/uploads/*' -o -path "$r/fileadmin/*" -o -path "$r/images/*" -o -path "$r/media/*" -o -path "$r/files/*" \) -type f \
       \( -name '*.php' -o -name '*.phtml' -o -name '*.php[0-9]' -o -name '*.phar' -o -name '*.suspected' \) \
       ! -name 'index.php' ! -path '*/wp-content/uploads/wc-logs/*' 2>/dev/null | head -8 |
    while read -r f; do printf 'X|%s|php_in_uploads|%s %s\n' "$r" "$(stat -c '%y' "$f" | cut -c1-10)" "${f#$r/}"; done
  # auto_prepend / search-engine redirects in .htaccess / .user.ini
  find "$r" -xdev -maxdepth 4 \( -name '.htaccess' -o -name '.user.ini' -o -name 'php.ini' \) -print0 2>/dev/null |
    xargs -0 -r grep -HnIE 'auto_(pre|ap)pend_file|HTTP_REFERER.*(google|bing|yahoo|yandex)|HTTP_USER_AGENT.*(google|bing).*\n?.*RewriteRule.*https?://' 2>/dev/null |
    grep -v 'wordfence-waf.php' | head -5 | while read -r l; do printf 'X|%s|htaccess|%s\n' "$r" "${l#$r/}"; done
  # recently changed PHP (7 days) outside caches
  local n; n=$(find "$r" -xdev \( -path '*/cache' -o -path '*/typo3temp' -o -path '*/var/cache' -o -path '*/storage/framework' -o -path '*/upgrade*' \) -prune -o -type f -name '*.php' -mtime -7 -print 2>/dev/null | wc -l)
  [ "$n" -gt 0 ] && printf 'X|%s|php_changed_7d|%s\n' "$r" "$n"
  # root-level oddities: short random php names, files with leading dots
  ls -1A "$r" 2>/dev/null | grep -E '^(\.[^.].*\.php|[a-z0-9]{6,12}\.php|wp-[a-z]+-[a-z0-9]{4,}\.php|.*\.php\.(suspected|bak)|adminer.*\.php|phpinfo\.php|info\.php|test\.php|shell.*\.php|up\.php|upload\.php|x\.php|db\.php)$' |
    grep -vE '^(wp-config|wp-settings|wp-load|wp-login|wp-cron|wp-signup|wp-activate|wp-comments-post|wp-mail|wp-links-opml|wp-trackback|wp-blog-header|xmlrpc|index|install|wp-config-sample|server|robots|sitemap|license|readme|config|configuration|htaccess)\.php$' |
    head -8 | while read -r f; do printf 'X|%s|odd_root_file|%s %s\n' "$r" "$(stat -c '%y' "$r/$f" | cut -c1-10)" "$f"; done
}

roots=$(find /home -mindepth 2 -maxdepth 6 \( -name 'node_modules' -o -name 'vendor' -o -name 'wp-content' -o -name 'typo3temp' -o -name 'fileadmin' -o -name '.git' -o -name 'logs' \) -prune -o \
     \( -path '*/wp-includes/version.php' -o -path '*/typo3/sysext/core/ext_emconf.php' -o -path '*/libraries/src/Version.php' -o -path '*/libraries/cms/version/version.php' \
        -o -path '*/core/lib/Drupal.php' -o -path '*/includes/bootstrap.inc' -o -name 'artisan' -o -path '*/system/core/CodeIgniter.php' -o -name 'composer.lock' \) -print 2>/dev/null |
     grep -vE '^/home/[^/]+\.[0-9]{9,}/')
H installs_found "$(echo "$roots" | grep -c .)"

# WordPress core against the official checksums (api.wordpress.org), without executing site code
cat > "$TMPD/wpsum.php" <<'PHP'
<?php
$r = $argv[1]; $tmp = $argv[2];
$v = file_get_contents("$r/wp-includes/version.php");
if (!preg_match('/\$wp_version\s*=\s*[\'"]([^\'"]+)/', $v, $m)) exit;
$ver = $m[1]; $loc = preg_match('/\$wp_local_package\s*=\s*[\'"]([^\'"]+)/', $v, $l) ? $l[1] : 'en_US';
$cf = "$tmp/sum-$ver-$loc.json";
if (!file_exists($cf)) {
  $j = @file_get_contents("https://api.wordpress.org/core/checksums/1.0/?version=$ver&locale=$loc");
  $d = $j ? json_decode($j, true) : null;
  if (!$d || empty($d['checksums'])) { $j = @file_get_contents("https://api.wordpress.org/core/checksums/1.0/?version=$ver&locale=en_US"); $d = $j ? json_decode($j, true) : null; }
  file_put_contents($cf, $d && !empty($d['checksums']) ? json_encode($d['checksums']) : '{}');
}
$sum = json_decode(file_get_contents($cf), true);
if (!$sum) { echo "no checksums for $ver/$loc
"; exit; }
$out = array();
foreach ($sum as $f => $md5) {
  if (strpos($f, 'wp-content/') === 0 || $f === 'wp-config-sample.php' || $f === 'readme.html' || $f === 'license.txt') continue;
  if (file_exists("$r/$f") && md5_file("$r/$f") !== $md5) $out[] = "modified: $f";
}
foreach (array('wp-admin', 'wp-includes') as $top) {
  $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator("$r/$top", FilesystemIterator::SKIP_DOTS));
  foreach ($it as $file) { $rel = substr($file->getPathname(), strlen($r) + 1);
    if (!isset($sum[$rel]) && !preg_match('/(\.DS_Store|error_log|\.mo|\.po|\.json|\.l10n\.php)$/', $rel)) $out[] = "unexpected: $rel"; }
}
foreach (glob("$r/wp-*.php") as $file) { $rel = basename($file); if (!isset($sum[$rel]) && $rel !== 'wp-config.php') $out[] = "unexpected: $rel"; }
foreach (array_slice($out, 0, 10) as $o) echo "$o
";
if (count($out) > 10) echo "... " . count($out) . " deviations in total
";
PHP
echo "$roots" | while read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    */wp-includes/version.php) r=${f%/wp-includes/version.php}
      v=$(grep -oE "^\\\$wp_version = '[^']+'" "$f" | cut -d"'" -f2)
      printf 'C|%s|wordpress|%s\n' "$r" "$v"
      for d in "$r"/wp-content/plugins/*/; do s=$(basename "$d"); pf=$(grep -lm1 'Plugin Name:' "$d"*.php 2>/dev/null | head -1)
        [ -n "$pf" ] && printf 'P|%s|%s|%s\n' "$r" "$s" "$(grep -m1 -iE '^[[:space:]/*#@]*Version:' "$pf" | sed -E 's/.*Version:[[:space:]]*//I' | tr -d '\r' | cut -c1-20)"; done
      for d in "$r"/wp-content/themes/*/; do [ -f "$d/style.css" ] && printf 'T|%s|%s|%s\n' "$r" "$(basename "$d")" "$(grep -m1 -iE '^[[:space:]*]*Version:' "$d/style.css" | sed -E 's/.*Version:[[:space:]]*//I' | tr -d '\r' | cut -c1-20)"; done
      php -d memory_limit=256M -d auto_prepend_file= -d open_basedir= "$TMPD/wpsum.php" "$r" "$TMPD" 2>/dev/null | while read -r l; do printf 'X|%s|wp_core_checksum|%s\n' "$r" "$l"; done
      [ -f "$r/wp-config.php" ] && grep -qE "DISALLOW_FILE_EDIT.*true" "$r/wp-config.php" 2>/dev/null || printf 'X|%s|info|file_edit_allowed\n' "$r"
      ;;
    */typo3/sysext/core/ext_emconf.php) r=${f%/typo3/sysext/core/ext_emconf.php}; r=${r%/vendor/typo3/cms-core}; r=${r%/typo3_src*}
      printf 'C|%s|typo3|%s\n' "$r" "$(grep -oE "'version' => '[^']+'" "$f" | head -1 | cut -d"'" -f4)";;
    */libraries/src/Version.php) r=${f%/libraries/src/Version.php}
      printf 'C|%s|joomla|%s.%s.%s\n' "$r" "$(grep -oE 'MAJOR_VERSION = [0-9]+' "$f" | grep -oE '[0-9]+$')" "$(grep -oE 'MINOR_VERSION = [0-9]+' "$f" | grep -oE '[0-9]+$')" "$(grep -oE 'PATCH_VERSION = [0-9]+' "$f" | grep -oE '[0-9]+$')";;
    */libraries/cms/version/version.php) r=${f%/libraries/cms/version/version.php}
      printf 'C|%s|joomla|%s.%s\n' "$r" "$(grep -oE "RELEASE = '[^']+'" "$f" | cut -d"'" -f2)" "$(grep -oE "DEV_LEVEL = '[^']+'" "$f" | cut -d"'" -f2)";;
    */core/lib/Drupal.php) r=${f%/core/lib/Drupal.php}; printf 'C|%s|drupal|%s\n' "$r" "$(grep -oE "VERSION = '[^']+'" "$f" | cut -d"'" -f2)";;
    */includes/bootstrap.inc) r=${f%/includes/bootstrap.inc}; grep -q "define('VERSION'" "$f" && printf 'C|%s|drupal|%s\n' "$r" "$(grep -oE "define\('VERSION', '[^']+'" "$f" | cut -d"'" -f4)";;
    */system/core/CodeIgniter.php) r=${f%/system/core/CodeIgniter.php}; r=${r%/application/..}
      printf 'C|%s|codeigniter|%s\n' "$r" "$(grep -oE "CI_VERSION', '[^']+'" "$f" | cut -d"'" -f3)";;
    */artisan) r=${f%/artisan}; lv=$(grep -A3 '"name": "laravel/framework"' "$r/composer.lock" 2>/dev/null | grep -oE '"version": "[^"]+"' | cut -d'"' -f4)
      printf 'C|%s|laravel|%s\n' "$r" "${lv:-?}";;
    */composer.lock) r=${f%/composer.lock}
      for p in shopware/core typo3/cms-core contao/core-bundle magento/framework symfony/http-kernel; do
        v=$(grep -A3 "\"name\": \"$p\"" "$f" 2>/dev/null | grep -oE '"version": "[^"]+"' | head -1 | cut -d'"' -f4)
        [ -n "$v" ] && printf 'C|%s|composer:%s|%s\n' "$r" "$p" "$v"; done;;
  esac
done

# Scan every live home's public dirs once (also homes without a detected CMS)
for h in /home/*/; do
  h=${h%/}; [[ "$h" =~ \.[0-9]{9,}$ ]] && continue
  for d in "$h/public_html" "$h/htdocs" "$h/httpdocs" "$h/www" "$h/web"; do [ -d "$d" ] && [ -r "$d" ] && [ ! -L "$d" ] && scan_root "$d"; done
done
H done "$(date '+%F %T')"
