#!/bin/bash
# First aid for a hanging website. Runs on the web servers as root,
# called only from the monitoring host through an SSH forced command of the "rescue" user:
#   command="sudo /usr/local/bin/site-rescue",no-pty,... in ~rescue/.ssh/authorized_keys
# The script reads the command from SSH_ORIGINAL_COMMAND and checks every word. It can only:
#   diag <domain>                       numbers about the site: busy PHP processes, most common network/user agent (without 403), timeouts
#   block <domain> ua <word>            block a user agent (403) in the site's .htaccess
#   block <domain> net <a.b>            block a /16 network (403)
#   unblock <domain>                    remove all blocks set by site-rescue for the site
#   audit                               check the whole server read-only (traces of compromise, versions), see site-audit
#   restart-pool <domain>               terminate only the PHP processes of this one site (the FPM master starts new ones);
#                                       with mod_php and mpm_itk, the Apache processes currently running as the site's user
# Every change: backup of the old .htaccess in /var/backups/site-rescue, a line in /var/log/site-rescue.log.
# Settings (optional): /etc/site-rescue.conf
#   OWN_NETS="127.0.0 10. 172.16. 192.168."   never blockable
#   POOL_RESTART_MIN=10                      minutes between two pool restarts of the same site
set -u
export LC_ALL=C
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
OWN_NETS="127.0.0 10. 172.16. 192.168."
POOL_RESTART_MIN=10
[ -r /etc/site-rescue.conf ] && . /etc/site-rescue.conf
LOG=/var/log/site-rescue.log
BK=/var/backups/site-rescue
STATE=/var/lib/site-rescue
BEGIN="# BEGIN site-rescue (automatic)"
END="# END site-rescue"
SENTINEL='255\.255\.255\.255'   # final line of the block (never matches), terminates the [OR] chain

die() { echo "error=$*"; exit 1; }
log() { echo "$(date '+%F %T') ${SSH_CLIENT%% *} $*" >> "$LOG"; }

read -r -a A <<< "${SSH_ORIGINAL_COMMAND:-$*}"
CMD="${A[0]:-}"; DOMAIN="${A[1]:-}"
# audit: weekly security/update check of the whole server, read-only (server/site-audit)
if [ "$CMD" = audit ] && [ "${#A[@]}" -eq 1 ]; then
  [ -x /usr/local/bin/site-audit ] || die "site-audit not installed"
  log "audit"
  exec /usr/local/bin/site-audit
fi
[[ "$DOMAIN" =~ ^[a-z0-9][a-z0-9.-]{1,80}\.[a-z]{2,12}$ ]] || die "invalid domain"
DOMAIN="${DOMAIN#www.}"

POOL=$(ls /etc/php/*/fpm/pool.d/"$DOMAIN".conf 2>/dev/null | head -1)
# Vhost file of the domain: domain as a whole word in ServerName/ServerAlias or in a mod_macro "Use" line
# -R: the entries in sites-enabled are mostly symlinks, which grep -r does not follow while searching
VHOST=$(grep -RilE "^\s*(Server(Name|Alias)|Use)\s.*(^|[[:space:].])${DOMAIN//./\\.}([[:space:]]|$)" /etc/apache2/sites-enabled 2>/dev/null | head -1)
realuser() { [ -n "$1" ] && [ "$(id -u "$1" 2>/dev/null || echo 0)" -ge 1000 ] && echo "$1"; }
# Site user (never root/www-data): AssignUserID (mpm_itk), "user =" in the FPM pool, otherwise an argument of the Use line
siteuser() {
  local u a
  [ -n "$VHOST" ] && u=$(awk 'tolower($1) == "assignuserid" { print $2; exit }' "$VHOST") && realuser "$u" && return
  [ -n "$POOL" ] && u=$(awk -F= '$1 ~ /^\s*user\s*$/ { gsub(/ /, "", $2); print $2; exit }' "$POOL") && realuser "$u" && return
  [ -n "$VHOST" ] || return 1
  for a in $(awk 'tolower($1) == "use" { $1 = ""; $2 = ""; print }' "$VHOST"); do realuser "${a//\"/}" && return; done
  return 1
}
# DocumentRoot: from the vhost, otherwise the last directory argument of the Use line (mod_php server macros:
# "Use VhostITK <user> <domain> /home/<x> /home/<x>/public_html/" - the first one is the home), otherwise
# /home/<user>/public_html
docroot() {
  local d a u last=""
  [ -n "$VHOST" ] && d=$(awk 'tolower($1) == "documentroot" { gsub(/"/, "", $2); print $2; exit }' "$VHOST") && [ -d "$d" ] && { echo "$d"; return; }
  if [ -n "$VHOST" ]; then
    for a in $(awk 'tolower($1) == "use" { $1 = ""; $2 = ""; print; exit }' "$VHOST"); do a="${a//\"/}"; [ "${a:0:1}" = / ] && [ -d "$a" ] && last="${a%/}"; done
    [ -n "$last" ] && { echo "$last"; return; }
  fi
  u=$(siteuser) && [ -d "/home/$u/public_html" ] && { echo "/home/$u/public_html"; return; }
  return 1
}
DOCROOT=$(docroot) || true
# FPM pools are often named after the main domain (alias shop.x.at -> pool sw6.x.at): then search
# through the site user (Use macro without user -> owner of the DocumentRoot)
if [ -z "$POOL" ] && ls /etc/php/*/fpm/pool.d/*.conf > /dev/null 2>&1; then
  PU=$(siteuser) || { [ -n "$DOCROOT" ] && PU=$(realuser "$(stat -c %U "$DOCROOT")"); } || PU=""
  [ -n "$PU" ] && POOL=$(grep -lE "^\s*user\s*=\s*$PU\s*$" /etc/php/*/fpm/pool.d/*.conf 2>/dev/null | head -1)
fi
POOLNAME=""
[ -n "$POOL" ] && POOLNAME=$(sed -n 's/^\[\(.*\)\]\s*$/\1/p' "$POOL" | head -1)
[ -n "$POOLNAME" ] || POOLNAME="$DOMAIN"
# Logs live next to public_html (/home/<x>/logs); for subdirectories as DocumentRoot (public_html/public) search upwards
LOGDIR=""
if [ -n "$DOCROOT" ]; then
  d=$(readlink -f "$DOCROOT")
  for i in 1 2 3; do d=$(dirname "$d"); [ -d "$d/logs" ] && { LOGDIR="$d/logs"; break; }; done
fi

case "$CMD" in
diag)
  echo "domain=$DOMAIN"
  echo "docroot=${DOCROOT:-unknown}"
  if [ -n "$POOL" ]; then
    max=$(awk -F= '/^\s*pm.max_children/ { gsub(/ /, "", $2); print $2 }' "$POOL")
    echo "pool=$POOLNAME"
    echo "pool_processes=$(pgrep -fc "php-fpm: pool $POOLNAME\$") of ${max:-?}"
  elif U=$(siteuser); then
    max=$(awk 'tolower($1) == "maxrequestworkers" { print $2; exit }' /etc/apache2/mods-enabled/mpm_prefork.conf 2>/dev/null)
    echo "apache_processes_for_site=$(pgrep -u "$U" -xc apache2) (all: $(pgrep -xc apache2) of ${max:-?})"
  else
    echo "pool=none found"
  fi
  echo "last=$(cut -d' ' -f1-3 /proc/loadavg)"
  if [ -r "$LOGDIR/access.log" ]; then
    T=$(mktemp) || die "mktemp"
    tail -n 5000 "$LOGDIR/access.log" > "$T"
    echo "requests_last=$(wc -l < "$T")"
    # Network and user agent only from requests that are not already rejected with 403 (already blocked bots
    # should not hide the actual cause)
    awk '$9 != 403 { split($1, o, "."); n[o[1] "." o[2]]++ } END { for (k in n) print n[k], k }' "$T" | sort -rn | head -3 | sed 's/^/net=/'
    awk -F'"' '{ split($3, f, " ") } f[1] != 403 { n[$6]++ } END { for (k in n) print n[k], substr(k, 1, 120) }' "$T" | sort -rn | head -3 | sed 's/^/agent=/'
    awk '{ print $9 }' "$T" | sort | uniq -c | sort -rn | head -5 | sed 's/^/status=/'
    rm -f "$T"
  fi
  if [ -r "$LOGDIR/error.log" ]; then
    # Timeouts of the last 15 minutes (Apache error log: "[Wed Oct 28 09:59:52.846114 2026]")
    M=$(for i in $(seq 0 14); do date -d "-$i min" '+%b %d %H:%M'; done | paste -sd'|')
    echo "timeouts_15min=$(tail -n 20000 "$LOGDIR/error.log" | grep -E "($M):" | grep -c 'AH01075\|timeout specified has expired')"
  fi
  sed -n "/^$BEGIN/,/^$END/p" "$DOCROOT/.htaccess" 2>/dev/null | grep '^RewriteCond' | grep -vcF "$SENTINEL" | sed 's/^/active_blocks=/'
  ;;

block|unblock)
  [ -n "$DOCROOT" ] && [ -d "$DOCROOT" ] || die "webspace not found"
  H="$DOCROOT/.htaccess"
  RULES=""
  if [ "$CMD" = block ]; then
    KIND="${A[2]:-}"; VAL="${A[3]:-}"
    case "$KIND" in
      ua)  [[ "$VAL" =~ ^[A-Za-z][A-Za-z0-9._/-]{3,59}$ ]] || die "invalid user-agent word"
           [[ "$VAL" =~ ^(Mozilla|Chrome|Safari|Firefox|AppleWebKit|Gecko|KHTML|Mobile|Windows|Macintosh|Linux|Android|iPhone)(/.*)?$ ]] \
             && die "too generic, would block real visitors"
           [[ "$VAL" =~ ^(Googlebot|bingbot|WordPress)$ ]] && die "not blockable"
           RULES="RewriteCond %{HTTP_USER_AGENT} \"${VAL//./\\.}\" [NC,OR]" ;;
      net) [[ "$VAL" =~ ^([0-9]{1,3})\.([0-9]{1,3})$ ]] || die "invalid network (a.b)"
           for o in $OWN_NETS; do [ "$o" = "$VAL" ] && die "own network"; done
           RULES="RewriteCond %{REMOTE_ADDR} ^${VAL//./\\.}\. [OR]" ;;
      *)   die "block ua|net" ;;
    esac
    grep -qF "$RULES" "$H" 2>/dev/null && { echo "ok=already blocked"; exit 0; }
  fi
  mkdir -p "$BK" "$STATE"
  [ -f "$H" ] && cp -p "$H" "$BK/$DOMAIN.htaccess.$(date +%Y%m%d-%H%M%S)"
  OLD=""; [ -f "$H" ] && OLD=$(sed -n "/^$BEGIN/,/^$END/p" "$H" | grep '^RewriteCond' | grep -vF "$SENTINEL")
  NEW=$(printf '%s\n%s\n' "$OLD" "$RULES" | grep -v '^$' | sort -u)
  [ "$CMD" = unblock ] && NEW=""
  TMP=$(mktemp "$DOCROOT/.htaccess.rescue.XXXXXX")
  {
    if [ -n "$NEW" ]; then
      echo "$BEGIN"
      echo "<IfModule mod_rewrite.c>"
      echo "RewriteEngine On"
      echo "$NEW"
      echo "RewriteCond %{REMOTE_ADDR} ^255\\.255\\.255\\.255\$"
      echo "RewriteRule ^ - [F,L]"
      echo "</IfModule>"
      echo "$END"
    fi
    [ -f "$H" ] && sed "/^$BEGIN/,/^$END/d" "$H"
  } > "$TMP"
  if [ -f "$H" ]; then chown --reference="$H" "$TMP"; chmod --reference="$H" "$TMP"
  else chown "$(stat -c %U:%G "$DOCROOT")" "$TMP"; chmod 644 "$TMP"; fi
  mv "$TMP" "$H"
  log "$CMD $DOMAIN ${A[2]:-} ${A[3]:-}"
  echo "ok=$CMD $DOMAIN ${A[2]:-} ${A[3]:-}"
  echo "active_blocks=$(printf '%s\n' "$NEW" | grep -c '^RewriteCond')"
  ;;

restart-pool)
  U=""
  [ -n "$POOL" ] || U=$(siteuser) || die "neither php-fpm pool nor mpm_itk user for $DOMAIN"
  mkdir -p "$STATE"; S="$STATE/restart.$DOMAIN"
  if [ -f "$S" ] && [ $(( $(date +%s) - $(stat -c %Y "$S") )) -lt $(( POOL_RESTART_MIN * 60 )) ]; then
    die "last restart less than $POOL_RESTART_MIN min ago"
  fi
  touch "$S"
  if [ -n "$POOL" ]; then
    n=$(pgrep -fc "php-fpm: pool $POOLNAME\$")
    pkill -TERM -f "php-fpm: pool $POOLNAME\$"; sleep 3
    pkill -KILL -f "php-fpm: pool $POOLNAME\$" 2>/dev/null
  else
    # mpm_itk: only children currently running as the site's user; the Apache main process (root) starts new ones
    n=$(pgrep -u "$U" -xc apache2)
    pkill -TERM -u "$U" -x apache2; sleep 3
    pkill -KILL -u "$U" -x apache2 2>/dev/null
  fi
  log "restart-pool $DOMAIN ($n processes terminated${U:+, mpm_itk $U})"
  echo "ok=restart-pool $DOMAIN, $n processes terminated"
  ;;

*) die "allowed: diag | block | unblock | restart-pool" ;;
esac
