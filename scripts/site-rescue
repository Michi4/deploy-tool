#!/bin/bash
# Erste Hilfe für eine hängende Website. Läuft auf den Webservern als root,
# aufgerufen nur vom Monitoring-Host über einen SSH-Forced-Command des Benutzers "rescue":
#   command="sudo /usr/local/bin/site-rescue",no-pty,... in ~rescue/.ssh/authorized_keys
# Den Befehl liest das Skript aus SSH_ORIGINAL_COMMAND und prüft jedes Wort. Es kann nur:
#   diag <domain>                       Zahlen zur Website: belegte PHP-Prozesse, häufigstes Netz/User-Agent (ohne 403), Timeouts
#   block <domain> ua <wort>            User-Agent sperren (403) in der .htaccess der Website
#   block <domain> net <a.b>            /16-Netz sperren (403)
#   unblock <domain>                    alle von site-rescue gesetzten Sperren der Website entfernen
#   audit                               ganzen Server nur lesend prüfen (Hack-Spuren, Versionen), siehe site-audit
#   restart-pool <domain>               nur die PHP-Prozesse dieser einen Website beenden (der FPM-Master startet neue);
#                                       bei mod_php mit mpm_itk die Apache-Prozesse, die gerade als Benutzer der Website laufen
# Jede Änderung: Sicherung der alten .htaccess in /var/backups/site-rescue, Zeile in /var/log/site-rescue.log.
# Einstellungen (optional): /etc/site-rescue.conf
#   OWN_NETS="127.0.0 10. 172.16. 192.168."   nie sperrbar
#   POOL_RESTART_MIN=10                      Minuten zwischen zwei Pool-Neustarts derselben Website
set -u
export LC_ALL=C
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
OWN_NETS="127.0.0 10. 172.16. 192.168."
POOL_RESTART_MIN=10
[ -r /etc/site-rescue.conf ] && . /etc/site-rescue.conf
LOG=/var/log/site-rescue.log
BK=/var/backups/site-rescue
STATE=/var/lib/site-rescue
BEGIN="# BEGIN site-rescue (automatisch)"
END="# END site-rescue"
SENTINEL='255\.255\.255\.255'   # Schlusszeile des Blocks (nie zutreffend), beendet die [OR]-Kette

die() { echo "fehler=$*"; exit 1; }
log() { echo "$(date '+%F %T') ${SSH_CLIENT%% *} $*" >> "$LOG"; }

read -r -a A <<< "${SSH_ORIGINAL_COMMAND:-$*}"
CMD="${A[0]:-}"; DOMAIN="${A[1]:-}"
# audit: wöchentliche Sicherheits-/Update-Prüfung des ganzen Servers, nur lesend (server/site-audit)
if [ "$CMD" = audit ] && [ "${#A[@]}" -eq 1 ]; then
  [ -x /usr/local/bin/site-audit ] || die "site-audit nicht installiert"
  log "audit"
  exec /usr/local/bin/site-audit
fi
[[ "$DOMAIN" =~ ^[a-z0-9][a-z0-9.-]{1,80}\.[a-z]{2,12}$ ]] || die "domain ungültig"
DOMAIN="${DOMAIN#www.}"

POOL=$(ls /etc/php/*/fpm/pool.d/"$DOMAIN".conf 2>/dev/null | head -1)
# Vhost-Datei der Domain: Domain als ganzes Wort in ServerName/ServerAlias oder in einer mod_macro-"Use"-Zeile
# -R: die Einträge in sites-enabled sind meist Symlinks, die grep -r beim Durchsuchen nicht verfolgt
VHOST=$(grep -RilE "^\s*(Server(Name|Alias)|Use)\s.*(^|[[:space:].])${DOMAIN//./\\.}([[:space:]]|$)" /etc/apache2/sites-enabled 2>/dev/null | head -1)
realuser() { [ -n "$1" ] && [ "$(id -u "$1" 2>/dev/null || echo 0)" -ge 1000 ] && echo "$1"; }
# Benutzer der Website (nie root/www-data): AssignUserID (mpm_itk), "user =" im FPM-Pool, sonst ein Argument der Use-Zeile
siteuser() {
  local u a
  [ -n "$VHOST" ] && u=$(awk 'tolower($1) == "assignuserid" { print $2; exit }' "$VHOST") && realuser "$u" && return
  [ -n "$POOL" ] && u=$(awk -F= '$1 ~ /^\s*user\s*$/ { gsub(/ /, "", $2); print $2; exit }' "$POOL") && realuser "$u" && return
  [ -n "$VHOST" ] || return 1
  for a in $(awk 'tolower($1) == "use" { $1 = ""; $2 = ""; print }' "$VHOST"); do realuser "${a//\"/}" && return; done
  return 1
}
# DocumentRoot: aus dem Vhost, sonst das letzte Verzeichnis-Argument der Use-Zeile (Makros der mod_php-Server:
# "Use VhostITK <benutzer> <domain> /home/<x> /home/<x>/public_html/" – das erste ist das Home), sonst
# /home/<benutzer>/public_html
docroot() {
  local d a u last=""
  [ -n "$VHOST" ] && d=$(awk 'tolower($1) == "documentroot" { gsub(/"/, "", $2); print $2; exit }' "$VHOST") && [ -d "$d" ] && { echo "$d"; return; }
  if [ -n "$VHOST" ]; then
    for a in $(awk 'tolower($1) == "use" { $1 = ""; $2 = ""; print; exit }' "$VHOST"); do a="${a//\"/}"; [ "${a:0:1}" = / ] && [ -d "$a" ] && last="${a%/}"; done
    [ -n "$last" ] && { echo "$last"; return; }
  fi
  u=$(siteuser) && [ -d "/home/$u/public_html" ] && { echo "/home/$u/public_html"; return; }
  return 1
}
DOCROOT=$(docroot) || true
# FPM-Pool heißt oft nach der Hauptdomain (Alias shop.x.at → Pool sw6.x.at): dann über den Benutzer der Website
# suchen (Use-Makro ohne Benutzer → Besitzer des DocumentRoot)
if [ -z "$POOL" ] && ls /etc/php/*/fpm/pool.d/*.conf > /dev/null 2>&1; then
  PU=$(siteuser) || { [ -n "$DOCROOT" ] && PU=$(realuser "$(stat -c %U "$DOCROOT")"); } || PU=""
  [ -n "$PU" ] && POOL=$(grep -lE "^\s*user\s*=\s*$PU\s*$" /etc/php/*/fpm/pool.d/*.conf 2>/dev/null | head -1)
fi
POOLNAME=""
[ -n "$POOL" ] && POOLNAME=$(sed -n 's/^\[\(.*\)\]\s*$/\1/p' "$POOL" | head -1)
[ -n "$POOLNAME" ] || POOLNAME="$DOMAIN"
# Logs liegen neben public_html (/home/<x>/logs); bei Unterordnern als DocumentRoot (public_html/public) nach oben suchen
LOGDIR=""
if [ -n "$DOCROOT" ]; then
  d=$(readlink -f "$DOCROOT")
  for i in 1 2 3; do d=$(dirname "$d"); [ -d "$d/logs" ] && { LOGDIR="$d/logs"; break; }; done
fi

case "$CMD" in
diag)
  echo "domain=$DOMAIN"
  echo "docroot=${DOCROOT:-unbekannt}"
  if [ -n "$POOL" ]; then
    max=$(awk -F= '/^\s*pm.max_children/ { gsub(/ /, "", $2); print $2 }' "$POOL")
    echo "pool=$POOLNAME"
    echo "pool_prozesse=$(pgrep -fc "php-fpm: pool $POOLNAME\$") von ${max:-?}"
  elif U=$(siteuser); then
    max=$(awk 'tolower($1) == "maxrequestworkers" { print $2; exit }' /etc/apache2/mods-enabled/mpm_prefork.conf 2>/dev/null)
    echo "apache_prozesse_der_website=$(pgrep -u "$U" -xc apache2) (alle: $(pgrep -xc apache2) von ${max:-?})"
  else
    echo "pool=keiner gefunden"
  fi
  echo "last=$(cut -d' ' -f1-3 /proc/loadavg)"
  if [ -r "$LOGDIR/access.log" ]; then
    T=$(mktemp) || die "mktemp"
    tail -n 5000 "$LOGDIR/access.log" > "$T"
    echo "anfragen_letzte=$(wc -l < "$T")"
    # Netz und User-Agent nur über Zugriffe, die nicht schon mit 403 abgewiesen werden (bereits gesperrte Bots
    # sollen die eigentliche Ursache nicht verdecken)
    awk '$9 != 403 { split($1, o, "."); n[o[1] "." o[2]]++ } END { for (k in n) print n[k], k }' "$T" | sort -rn | head -3 | sed 's/^/netz=/'
    awk -F'"' '{ split($3, f, " ") } f[1] != 403 { n[$6]++ } END { for (k in n) print n[k], substr(k, 1, 120) }' "$T" | sort -rn | head -3 | sed 's/^/agent=/'
    awk '{ print $9 }' "$T" | sort | uniq -c | sort -rn | head -5 | sed 's/^/status=/'
    rm -f "$T"
  fi
  if [ -r "$LOGDIR/error.log" ]; then
    # Timeouts der letzten 15 Minuten (Apache-Fehlerlog: "[Wed Oct 28 09:59:52.846114 2026]")
    M=$(for i in $(seq 0 14); do date -d "-$i min" '+%b %d %H:%M'; done | paste -sd'|')
    echo "timeouts_15min=$(tail -n 20000 "$LOGDIR/error.log" | grep -E "($M):" | grep -c 'AH01075\|timeout specified has expired')"
  fi
  sed -n "/^$BEGIN/,/^$END/p" "$DOCROOT/.htaccess" 2>/dev/null | grep '^RewriteCond' | grep -vcF "$SENTINEL" | sed 's/^/sperren_aktiv=/'
  ;;

block|unblock)
  [ -n "$DOCROOT" ] && [ -d "$DOCROOT" ] || die "webspace nicht gefunden"
  H="$DOCROOT/.htaccess"
  RULES=""
  if [ "$CMD" = block ]; then
    KIND="${A[2]:-}"; VAL="${A[3]:-}"
    case "$KIND" in
      ua)  [[ "$VAL" =~ ^[A-Za-z][A-Za-z0-9._/-]{3,59}$ ]] || die "user-agent-wort ungültig"
           [[ "$VAL" =~ ^(Mozilla|Chrome|Safari|Firefox|AppleWebKit|Gecko|KHTML|Mobile|Windows|Macintosh|Linux|Android|iPhone)(/.*)?$ ]] \
             && die "zu allgemein, würde echte Besucher sperren"
           [[ "$VAL" =~ ^(Googlebot|bingbot|WordPress)$ ]] && die "nicht sperrbar"
           RULES="RewriteCond %{HTTP_USER_AGENT} \"${VAL//./\\.}\" [NC,OR]" ;;
      net) [[ "$VAL" =~ ^([0-9]{1,3})\.([0-9]{1,3})$ ]] || die "netz ungültig (a.b)"
           for o in $OWN_NETS; do [ "$o" = "$VAL" ] && die "eigenes netz"; done
           RULES="RewriteCond %{REMOTE_ADDR} ^${VAL//./\\.}\\. [OR]" ;;
      *)   die "block ua|net" ;;
    esac
    grep -qF "$RULES" "$H" 2>/dev/null && { echo "ok=schon gesperrt"; exit 0; }
  fi
  mkdir -p "$BK" "$STATE"
  [ -f "$H" ] && cp -p "$H" "$BK/$DOMAIN.htaccess.$(date +%Y%m%d-%H%M%S)"
  OLD=""; [ -f "$H" ] && OLD=$(sed -n "/^$BEGIN/,/^$END/p" "$H" | grep '^RewriteCond' | grep -vF "$SENTINEL")
  NEW=$(printf '%s\n%s\n' "$OLD" "$RULES" | grep -v '^$' | sort -u)
  [ "$CMD" = unblock ] && NEW=""
  TMP=$(mktemp "$DOCROOT/.htaccess.rescue.XXXXXX")
  {
    if [ -n "$NEW" ]; then
      echo "$BEGIN"
      echo "<IfModule mod_rewrite.c>"
      echo "RewriteEngine On"
      echo "$NEW"
      echo "RewriteCond %{REMOTE_ADDR} ^255\\.255\\.255\\.255\$"
      echo "RewriteRule ^ - [F,L]"
      echo "</IfModule>"
      echo "$END"
    fi
    [ -f "$H" ] && sed "/^$BEGIN/,/^$END/d" "$H"
  } > "$TMP"
  if [ -f "$H" ]; then chown --reference="$H" "$TMP"; chmod --reference="$H" "$TMP"
  else chown "$(stat -c %U:%G "$DOCROOT")" "$TMP"; chmod 644 "$TMP"; fi
  mv "$TMP" "$H"
  log "$CMD $DOMAIN ${A[2]:-} ${A[3]:-}"
  echo "ok=$CMD $DOMAIN ${A[2]:-} ${A[3]:-}"
  echo "sperren_aktiv=$(printf '%s\n' "$NEW" | grep -c '^RewriteCond')"
  ;;

restart-pool)
  U=""
  [ -n "$POOL" ] || U=$(siteuser) || die "weder php-fpm-pool noch mpm_itk-benutzer für $DOMAIN"
  mkdir -p "$STATE"; S="$STATE/restart.$DOMAIN"
  if [ -f "$S" ] && [ $(( $(date +%s) - $(stat -c %Y "$S") )) -lt $(( POOL_RESTART_MIN * 60 )) ]; then
    die "letzter neustart vor weniger als $POOL_RESTART_MIN min"
  fi
  touch "$S"
  if [ -n "$POOL" ]; then
    n=$(pgrep -fc "php-fpm: pool $POOLNAME\$")
    pkill -TERM -f "php-fpm: pool $POOLNAME\$"; sleep 3
    pkill -KILL -f "php-fpm: pool $POOLNAME\$" 2>/dev/null
  else
    # mpm_itk: nur Kinder, die gerade als Benutzer der Website laufen; der Apache-Hauptprozess (root) startet neue
    n=$(pgrep -u "$U" -xc apache2)
    pkill -TERM -u "$U" -x apache2; sleep 3
    pkill -KILL -u "$U" -x apache2 2>/dev/null
  fi
  log "restart-pool $DOMAIN ($n prozesse beendet${U:+, mpm_itk $U})"
  echo "ok=restart-pool $DOMAIN, $n prozesse beendet"
  ;;

*) die "erlaubt: diag | block | unblock | restart-pool" ;;
esac
