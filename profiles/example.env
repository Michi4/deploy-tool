# Example profile: site-rescue-audit on two invented hosts.
# Copy to profiles/local.env and change the values.
RECIPE="site-rescue-audit"
TARGETS="web1.example.com,web2.example.com"

SSH_USER="root"
SSH_KEY="~/.ssh/id_ed25519"
SSH_PORT="22"

SYSTEM_USER="rescue"
SYSTEM_USER_GROUPS="sshallow"
WHITELIST_IP="203.0.113.10"
RESCUE_PUBKEY="file:../keys/example_key.pub"

SUDOERS_NAME="site-rescue"
SUDOERS_CONTENT='Defaults:rescue env_keep += "SSH_ORIGINAL_COMMAND"
rescue ALL=(root) NOPASSWD: /usr/local/bin/site-rescue'

ALLOW_EXISTING_USER="1"
ROLLBACK_ON_FAIL="1"
BIN_DIR="/usr/local/bin"
SCRIPTS_DIR="./scripts"

# acme-target (used by -r acme-target and checked by selftest)
ACME_USER="acmepush"
ACME_PUSH_PUBKEY="file:../keys/example_key.pub"
ACME_PUSH_IP="192.0.2.10"
