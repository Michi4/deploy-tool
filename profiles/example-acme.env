# Example profile: acme-target, the receiver side for acme-rollout.
# Copy to profiles/local-acme.env and change the values.
RECIPE="acme-target"
TARGETS="web1.example.com,web2.example.com"

SSH_USER="root"
SSH_KEY="~/.ssh/id_ed25519"
SSH_PORT="22"

ACME_USER="acmepush"
ACME_PUSH_PUBKEY="file:../keys/example_key.pub"
ACME_PUSH_IP="192.0.2.10"
SCRIPTS_DIR="./scripts"
